<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>top.katzenyasax.kuaikan</groupId>
        <artifactId>kuaikan-services</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>search-service</artifactId>
    <name>search-service</name>

    <dependencies>
        <dependency>
            <groupId>top.katzenyasax.kuaikan</groupId>
            <artifactId>kuaikan-common</artifactId>
        </dependency>
        <!-- 身份上下文 + Feign 身份传播。缺这个依赖会导致：
             服务读到 header 却没人构造 UserContext → 永远匿名；
             Feign 调用不转发身份 → 下游看不到用户。且完全静默。 -->
        <dependency>
            <groupId>top.katzenyasax.kuaikan</groupId>
            <artifactId>kuaikan-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- ES 客户端刻意用 Spring 自带的 RestClient（spring-web 内），**不引**
             elasticsearch-java / spring-data-elasticsearch：
             本服务只需要 _bulk / _aliases / _update_by_query / _refresh 这几个 REST 端点，
             官方客户端会额外带一堆 transport/Jackson 版本约束，收益为零。 -->

        <!-- 社群名不可变 → 本地永久缓存，上限 2000 条（p6-search.md §3.2）。
             版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- 版本由 SCA BOM 管理：rocketmq-client 5.3.1（Remoting，不用 Proxy）。
             search 只是纯消费方，只引 client，不引 common-outbox -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
        </dependency>

        <!-- 只引 api 版，不引 swagger-ui 版：契约端点放在 /internal/api-docs，且不暴露 UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
