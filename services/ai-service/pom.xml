            <artifactId>kuaikan-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>top.katzenyasax.kuaikan</groupId>
            <artifactId>kuaikan-common-outbox</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
