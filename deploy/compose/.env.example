# kuaikan 环境变量模板
#
# 真实文件在服务器 /opt/kuaikan/env/kuaikan.env，权限 600，不进 git。
# 生成方式：  deploy/bin/gen-env.sh
#
# 变量说明：
#   MYSQL_ROOT_PASSWORD         MySQL root 密码
#   MYSQL_PWD_*                 各服务 schema 的受限账号密码（ADR 0006 一库一账号）
#   REDIS_PASSWORD              Redis requirepass
#   APP_TAG                     镜像 tag，回滚时改这个值后 up -d 即可

MYSQL_ROOT_PASSWORD=change-me
MYSQL_PWD_USER=change-me
MYSQL_PWD_COMMUNITY=change-me
MYSQL_PWD_CONTENT=change-me
MYSQL_PWD_INTERACTION=change-me
MYSQL_PWD_NOTIFICATION=change-me
REDIS_PASSWORD=change-me
APP_TAG=dev
